---
# Front Matter comment to ensure Jekyll properly reads file.
---

{%- include meta.liquid -%}

{%- assign a_c_192 = false -%}
{%- assign a_c_512 = false -%}
{%- for static_file in site.static_files -%}
  {%- if static_file.path contains "android-chrome-192x192.png" -%}
    {%- assign a_c_192 = static_file.path -%}
  {%- endif -%}
  {%- if static_file.path contains "android-chrome-512x512.png" -%}
    {%- assign a_c_512 = static_file.path -%}
  {%- endif -%}
{%- endfor -%}

{
  "name": "{{ site.title | default: site.github.repository_name | escape }}",
  "short_name": "{{ site.title | default: site.github.repository_name | escape }}",
  "icons": [
    {%- if a_c_192 != false -%}
      {
        "src": "{{ a_c_192 | absolute_url }}",
        "sizes": "192x192",
        "type": "image/png"
      }
    {%- endif -%}
    {%- if a_c_192 != false and a_c_512 != false -%} , {%- endif -%}
    {%- if a_c_512 != false -%}
      {
        "src": "{{ a_c_512 | absolute_url }}",
        "sizes": "512x512",
        "type": "image/png"
      }
    {%- endif -%}
  ],
  {%- if meta.theme.color %}
    "theme_color": "{{ meta.theme.color }}",
    "background_color": "{{ meta.theme.color }}",
  {%- endif %}
  "display": "standalone"
}
